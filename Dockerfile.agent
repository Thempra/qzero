# QZero Agent — lightweight real-time traffic monitoring sensor
# Deploy this on ANY server; it pushes alerts to a central QZero hub.
# Requires NET_ADMIN/NET_RAW capability to capture traffic.

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcap0.8 \
    tcpdump \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# qzero needs libpcap headers at build; we copy everything for the editable build
COPY pyproject.toml requirements.txt requirements-dev.txt ./
COPY src/ ./src/

# Install with full deps so the agent can train/load the quantum models locally
# (QZeroPredictor needs numpy/pandas/sklearn + qiskit/torch for real detection).
#
# torch>=2.0.0 from PyPI now (2.13+) bundles a ~3.5GB CUDA toolchain which is
# wasted on this CPU-only VM and makes builds slow/unreliable. Install the
# CPU-only wheel first so `pip install .[all]` treats torch as already satisfied
# and never pulls the CUDA packages.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir "./[all]"

# libpcap runtime
ENV PYTHONUNBUFFERED=1
ENV QZERO_INTERFACE=eth0
ENV QZERO_INTERVAL=5.0
ENV QZERO_HUB_URL=""
ENV QZERO_PROMISCUOUS=0

# Agent entrypoint
ENTRYPOINT ["qzero", "agent"]

# Health probe: the agent exposes no HTTP, so verify the process is alive.
# The [q] bracket stops pgrep -f from matching this healthcheck's own shell,
# which would otherwise report "healthy" even if the agent process died.
HEALTHCHECK --interval=60s --timeout=10s --start-period=300s --retries=3 \
    CMD pgrep -f "[q]zero agent" > /dev/null || exit 1
