# QZero Environment Configuration
# Copy to .env and adjust for your Coolify deployment

# ─── API ───
QZERO_ENV=production
LOG_LEVEL=INFO
API_PORT=8000
DASHBOARD_PORT=8501

# ─── Model Configuration ───
QZERO_N_QUBITS=4
QZERO_DEFAULT_THRESHOLD=0.7

# ─── Resource Limits (Coolify) ───
QZERO_CPU_LIMIT=4       # CPU cores limit
QZERO_MEM_LIMIT=8G      # Memory limit

# ─── API Key (optional, for auth) ───
# QZERO_API_KEY=your-secret-api-key
